<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="UTF-8" />

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    <%= title %>
  </title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">

  <link rel="stylesheet" href="stylesheet/auth/login.css">
</head>

<body>

  <main class="auth-page">

    <section class="auth-container">

      <!-- ================= VISUAL ================= -->

      <div class="visual-section">

        <div class="visual-overlay"></div>

        <div class="brand">
          <span class="brand-orange">pa</span><span>wear</span>
        </div>

        <div class="visual-content">

          <div class="visual-badge">
            <span></span>
            پوشاک با کیفیت
          </div>

          <h2>
            قدرت در<br>
            <span>هر قدم</span>
          </h2>

          <p>
            جوراب‌هایی که برای راحتی،
            استایل و استفاده روزمره طراحی شده‌اند.
          </p>

          <div class="features">

            <div class="feature">
              <div class="feature-icon">✓</div>

              <div>
                <strong>کیفیت بالا</strong>
                <small>با بهترین الیاف طبیعی</small>
              </div>
            </div>

            <div class="feature">
              <div class="feature-icon">♢</div>

              <div>
                <strong>دوام و ماندگاری</strong>
                <small>دوخت محکم و طول عمر بالا</small>
              </div>
            </div>

            <div class="feature">
              <div class="feature-icon">↕</div>

              <div>
                <strong>راحتی بی‌نظیر</strong>
                <small>تنفس‌پذیر و ضد تعریق</small>
              </div>
            </div>

            <div class="feature">
              <div class="feature-icon">→</div>

              <div>
                <strong>ارسال سریع</strong>
                <small>ارسال به سراسر ایران</small>
              </div>
            </div>

          </div>

        </div>

        <div class="visual-bottom">
          POWER IN EVERY STEP
        </div>

      </div>


      <!-- ================= FORM ================= -->

      <div class="form-section">

        <div class="form-wrapper">

          <div class="mobile-logo">
            <span class="brand-orange">pa</span><span>wear</span>
          </div>

          <div class="form-box">

            <div class="form-header">

              <h1>
                ورود به حساب کاربری
              </h1>

              <p>
                برای ادامه وارد حساب کاربری خود شوید.
              </p>

            </div>


            <form id="loginForm" novalidate>

              <!-- PHONE -->

              <div class="input-group">

                <label for="loginPhone">
                  شماره موبایل
                </label>

                <div class="input-wrapper">

                  <span class="input-icon">
                    ☎
                  </span>

                  <input type="tel" id="loginPhone" name="phonenumber" placeholder="مثلاً 09121234567"
                    autocomplete="tel" inputmode="numeric" maxlength="11" dir="ltr">

                </div>

                <small id="loginPhoneError" class="field-error"></small>

              </div>


              <!-- PASSWORD -->

              <div class="input-group">

                <label for="loginPassword">
                  رمز عبور
                </label>

                <div class="input-wrapper">

                  <span class="input-icon">
                    🔒
                  </span>

                  <input type="password" id="loginPassword" name="password" placeholder="رمز عبور خود را وارد کنید"
                    autocomplete="current-password">

                  <button type="button" class="password-toggle" data-target="loginPassword" aria-label="نمایش رمز عبور">
                    ◉
                  </button>

                </div>

                <small id="loginPasswordError" class="field-error"></small>

              </div>


              <!-- OPTIONS -->

              <div class="form-options">

                <label class="remember">

                  <input type="checkbox" id="rememberMe">

                  <span>
                    مرا به خاطر بسپار
                  </span>

                </label>

                <a href="#" class="forgot">
                  رمز عبور را فراموش کرده‌اید؟
                </a>

              </div>


              <!-- SUBMIT -->

              <button type="submit" class="submit-btn" id="loginSubmit">
                <span class="btn-text">
                  ورود
                </span>

                <span class="btn-arrow">
                  ←
                </span>
              </button>


              <div class="divider">
                <span>یا</span>
              </div>


              <button type="button" class="google-btn">
                <span class="google-icon">
                  G
                </span>

                ورود با حساب گوگل
              </button>


              <div class="switch-form">

                حساب کاربری ندارید؟

                <a href="/signup">
                  ثبت‌نام کنید
                </a>

              </div>

            </form>


            <div id="message" class="message" role="alert"></div>

          </div>

        </div>

      </div>

    </section>

  </main>

  <script src="/javascript/auth/login.js"></script>

</body>

</html>